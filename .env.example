# Copy this file to backend/.env and fill in real values.
# The backend reads its environment from backend/.env (see backend/src/config/env.ts).
# Never commit the actual .env file.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/hostel_management

# --- Auth: JSON Web Tokens ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS / Cookies ---
# URL of the frontend dev/prod app (used for CORS + cookie scoping)
CLIENT_URL=http://localhost:5173
