# Copy this file to a root .env (already gitignored via the bare ".env"
# pattern in .gitignore) before running docker-compose.
#
# docker-compose.yml's backend service reads every variable it needs from
# this file (or from exported shell/CI env vars, which take precedence) -
# nothing is hardcoded in the compose file. This is separate from
# backend/.env, which is only used when running the backend directly with
# `npm run dev` (no Docker).

# The backend URL the FRONTEND BUILD is baked with (production compose only).
# Vite inlines this at build time, and it is read by the user's browser, so
# it must be reachable from wherever the browser runs - normally the
# published backend port, NOT the internal Docker service name "backend".
VITE_API_URL=http://localhost:5000/api

# The origin the frontend is served from (production compose only). The
# backend uses this to set its CORS allow-origin (CLIENT_URL), so it must
# match exactly what the browser has in its address bar.
FRONTEND_ORIGIN=http://localhost:8080

# --- Backend secrets ---
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit real values - this file only holds placeholders.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Only needed if pointing the containerized backend at an external MongoDB
# (e.g. Atlas) instead of the "mongo" service this compose file already runs.
# MONGODB_URI=mongodb+srv://...
